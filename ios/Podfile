require_relative '../node_modules/react-native/scripts/react_native_pods'
require 'json'

# ----------------------------------------------------------------------------
#  THE NEW ARCHITECTURE, AND THE FILE THAT SAID NO AND WAS NEVER READ
# ----------------------------------------------------------------------------
#  ios/Podfile.properties.json has said `"newArchEnabled": "false"` all along.
#  Nothing read it. That key is an Expo convention and this is the plain React
#  Native Podfile, so the setting was a note to nobody: every `pod install`
#  printed "Configuring the target with the New Architecture" and the app was
#  built on Fabric and TurboModules regardless.
#
#  React Native 0.81 defaults it ON and turns it off for exactly one reason,
#  which is this environment variable. See
#  node_modules/react-native/scripts/cocoapods/new_architecture.rb:
#
#      return ENV["RCT_NEW_ARCH_ENABLED"] == '0' ? false : true
#
#  WHY IT MATTERS HERE. The device crash report is EXC_CRASH / SIGABRT with an
#  Objective-C exception rethrown on `com.meta.react.turbomodulemanager.queue`
#  - the TurboModule queue, which only exists under the new architecture. It
#  reproduced on an iPhone and not in the simulator, which is the usual shape
#  of a native module whose new-arch path is not exercised on x86.
#
#  So this reads the file rather than replacing it. The intent was already
#  written down; it just had nowhere to go. Flip the JSON to switch, and
#  `pod install` again.
# ----------------------------------------------------------------------------
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}
ENV['RCT_NEW_ARCH_ENABLED'] = podfile_properties['newArchEnabled'] == 'true' ? '1' : '0'

# ----------------------------------------------------------------------------
#  THE MINIMUM iOS, WHICH IS NOT THE SDK YOU BUILD WITH
# ----------------------------------------------------------------------------
#  This said 26.0, which is the version of Xcode on this machine rather than a
#  requirement of anything in the app. The two are independent: you compile
#  against the newest SDK and you declare the OLDEST OS you support, and
#  TestFlight offers the build to everybody at or above that line.
#
#  At 26.0 the only people who could install it were the ones running the same
#  beta as the developer.
#
#  15.1 is React Native 0.81.5's own floor - see
#  node_modules/react-native/scripts/cocoapods/helpers.rb,
#  `min_ios_version_supported` - and the pods already build at 13.0 and 15.1,
#  so nothing here was ever asking for more. Nothing in ios/Succesor uses an
#  API newer than that either: there is not a single @available in the folder.
#
#  RUN `pod install` AFTER CHANGING THIS. The pods carry their own copy of the
#  number and CocoaPods only rewrites them when it regenerates the project.
# ----------------------------------------------------------------------------
platform :ios, '15.1'

prepare_react_native_project!

target 'Succesor' do
  config = use_native_modules!

  use_frameworks! :linkage => :static

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true
  )

  post_install do |installer|
    react_native_post_install(installer)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end

    # --------------------------------------------------------------------
    #  GEÇİCİ YAMA: Xcode 26 (Apple Clang 21) + fmt 11.0.2 uyumsuzluğu
    # --------------------------------------------------------------------
    #  RN 0.81.5, RCT-Folly üzerinden fmt 11.0.2 çekiyor. fmt, __cpp_consteval
    #  gördüğünde FMT_USE_CONSTEVAL=1 yapıyor; Xcode 26'nın Clang'ı ise
    #  consteval kurallarını daha katı uyguluyor ve FMT_STRING makro
    #  açılımları "call to consteval function ... is not a constant
    #  expression" hatası veriyor.
    #
    #  NOT: base.h bu makroyu KOŞULSUZ tanımlıyor (#ifndef koruması yok),
    #  bu yüzden derleyiciye -DFMT_USE_CONSTEVAL=0 vermek işe yaramaz —
    #  dosyanın kendi tanımı kazanır. Dosyayı yamalamak zorunlu.
    #
    #  Yama, ilk #if dalını her zaman doğru yapıp FMT_USE_CONSTEVAL'ı 0'a
    #  sabitler. Kaybedilen tek şey format string'lerin derleme zamanı
    #  denetimi; çalışma davranışı aynı.
    #
    #  KALDIRMA KOŞULU: React Native >= 0.83.9'a çıkıldığında (fmt 12.1.0
    #  ile geliyor, Xcode 26 ile sorunsuz derleniyor) bu blok silinmeli.
    # --------------------------------------------------------------------
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      source = File.read(fmt_base)
      needle = "#if !defined(__cpp_lib_is_constant_evaluated)\n#  define FMT_USE_CONSTEVAL 0"
      marker = "#if 1 // PATCHED: Xcode 26 / Apple Clang 21\n#  define FMT_USE_CONSTEVAL 0"

      if source.include?(marker)
        Pod::UI.puts '[fmt yama] Zaten uygulanmis, atlandi.'
      elsif source.include?(needle)
        # CocoaPods indirdigi pod kaynaklarini salt-okunur birakabiliyor.
        # Yazmadan once izni acip sonra geri kapatiyoruz.
        original_mode = File.stat(fmt_base).mode
        begin
          File.chmod(0o644, fmt_base)
          File.write(fmt_base, source.sub(needle, marker))
          Pod::UI.puts '[fmt yama] FMT_USE_CONSTEVAL 0a sabitlendi (Xcode 26 uyumu).'
        ensure
          File.chmod(original_mode, fmt_base) rescue nil
        end
      else
        Pod::UI.warn '[fmt yama] Beklenen kod blogu bulunamadi. fmt surumu degismis olabilir; yama gerekli mi kontrol et.'
      end
    end
  end
end
